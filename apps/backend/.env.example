# Copy to .env and adjust. Never commit .env.

ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection. Matches docker-compose.yml, which publishes Postgres on 5433.
# Supabase example: postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://sih:sih_dev@localhost:5433/sih26092

# Comma separated origins allowed to call the API. Restrict to the deployed frontend in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recommendation engine boundary: mock | module | http
# module = Developer 1's real deterministic engine (top-level `intelligence` package) via the bridge.
# mock   = the labelled placeholder, useful only when the intelligence package is absent.
RECOMMENDATION_ENGINE=module
RECOMMENDATION_ENGINE_MODULE=app.intelligence.bridge:recommend
# For http: the engine service URL, e.g. http://localhost:8001/recommend
RECOMMENDATION_ENGINE_URL=
# Only needed when running the backend from a directory that cannot see the repo root.
SIH26092_REPO_ROOT=
RECOMMENDATION_ENGINE_TIMEOUT_SECONDS=10

# Partner search radius defaults (km)
DEFAULT_PARTNER_RADIUS_KM=50
MAX_PARTNER_RADIUS_KM=500
